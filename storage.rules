rules_version = '2';

// ============================================================================
// BẮN TANK ONLINE – FIREBASE STORAGE SECURITY RULES (M7.3.11.5)
// Project ID: bantank-bd525
// Storage Bucket: bantank-bd525.firebasestorage.app
// Admin duy nhất: linhnk2013@gmail.com (Thay thế hoàn toàn linhnk.online@gmail.com)
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasGoogleSignInProvider() {
      return ('firebase' in request.auth.token)
        && ('sign_in_provider' in request.auth.token.firebase)
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function hasNoHostedDomainClaim() {
      return !('hd' in request.auth.token)
        && (
          !('firebase' in request.auth.token)
          || !('sign_in_attributes' in request.auth.token.firebase)
          || !('hd' in request.auth.token.firebase.sign_in_attributes)
        );
    }

    // M7.3.11.5 Section 2.1: Đồng bộ 100% điều kiện xác thực Gmail cá nhân giữa Firestore Rules và Storage Rules
    function isVerifiedPersonalGmail() {
      return isSignedIn()
        && isValidId(request.auth.uid)
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 6
        && request.auth.token.email.size() <= 254
        && request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@(gmail|googlemail)\\.com$')
        && hasGoogleSignInProvider()
        && hasNoHostedDomainClaim();
    }

    // M7.3.11.5 Section 2.1: Điều kiện xác thực ADMIN duy nhất (linhnk2013@gmail.com)
    // - Email khớp chính xác linhnk2013@gmail.com
    // - email_verified == true
    // - Provider là google.com
    // - UID hợp lệ từ Firebase Authentication token
    // - Từ chối tuyệt đối email cũ linhnk.online@gmail.com
    function isAdmin() {
      return isVerifiedPersonalGmail()
        && request.auth.token.email.lower() == 'linhnk2013@gmail.com'
        && request.auth.token.email.lower() != 'linhnk.online@gmail.com';
    }

    function isValidCatalogPath(avatarId, versionSegment, fileName) {
      return avatarId is string
        && avatarId.size() >= 1
        && avatarId.size() <= 64
        && avatarId.matches('^[A-Za-z0-9_-]+$')
        && versionSegment is string
        && versionSegment.matches('^v[1-9][0-9]*$')
        && fileName is string
        && fileName.size() >= 5
        && fileName.size() <= 120
        && fileName.matches('^[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp)$');
    }

    function isValidCatalogCreate(avatarId, versionSegment, fileName) {
      return isValidCatalogPath(avatarId, versionSegment, fileName)
        && resource == null
        && request.resource != null
        && request.resource.size >= 1
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    function isValidCatalogDelete(avatarId, versionSegment, fileName) {
      return isValidCatalogPath(avatarId, versionSegment, fileName)
        && resource != null
        && request.resource == null;
    }

    // ------------------------------------------------------------------------
    // DANH MỤC AVATAR CHUNG: avatar_catalog/{avatarId}/{versionSegment}/{fileName}
    // ------------------------------------------------------------------------
    match /avatar_catalog/{avatarId}/{versionSegment}/{fileName} {
      // 1. Đọc 1 file: chỉ tài khoản Gmail cá nhân đã xác minh, đăng nhập bằng Google
      allow get: if isVerifiedPersonalGmail()
                 && isValidCatalogPath(avatarId, versionSegment, fileName);

      // 2. Liệt kê: cấm tuyệt đối (danh mục lấy từ Firestore /avatar_catalog)
      allow list: if false;

      // 3. Upload nội dung file mới: chỉ Admin duy nhất (linhnk2013@gmail.com), yêu cầu resource == null
      allow create: if isAdmin()
                    && isValidCatalogCreate(avatarId, versionSegment, fileName);

      // 4. Cập nhật metadata của file hiện có: cấm tuyệt đối
      allow update: if false;

      // 5. Xóa: chỉ Admin duy nhất (linhnk2013@gmail.com) khi resource != null && request.resource == null
      allow delete: if isAdmin()
                    && isValidCatalogDelete(avatarId, versionSegment, fileName);
    }

    // ------------------------------------------------------------------------
    // CHẶN MẶC ĐỊNH MỌI ĐƯỜNG DẪN KHÁC TRONG BUCKET
    // ------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
