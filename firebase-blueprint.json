{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "Khóa phiên đơn thiết bị (Single-Device Session Lock) chuẩn M7.1 với heartbeat 150s (tối thiểu 120s) và timeout 900s.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID của người chơi (ghi khi tạo mới tx.set, tùy chọn khi tx.update)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Mã phiên UUID v4 sinh ngẫu nhiên mới cho mỗi lần đăng nhập hợp lệ",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Mã định danh trình duyệt UUID v4 lưu trong localStorage",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Trạng thái phiên đang hoạt động (true) hoặc đã đăng xuất (false)"
        },
        "userAgentSummary": {
          "type": "string",
          "description": "Mô tả ngắn gọn trình duyệt/hệ điều hành tối đa 120 ký tự",
          "minLength": 1,
          "maxLength": 120
        },
        "loginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm bắt đầu phiên theo request.time"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm heartbeat gần nhất theo request.time"
        }
      },
      "required": [
        "sessionId",
        "deviceId",
        "isActive",
        "userAgentSummary",
        "loginAt",
        "lastActiveAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Metadata hồ sơ và lựa chọn ảnh đại diện của người chơi (M7.3.5: Ảnh Google hoặc Danh mục Avatar chung). Không lưu nội dung ảnh hay quyền hạn.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarType": { "type": "string", "enum": ["google", "catalog"] },
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "avatarUpdatedAt": { "type": "string", "format": "date-time" },
        "firstLoginAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "loginCount": { "type": "number" }
      },
      "required": ["avatarType", "avatarId", "avatarUpdatedAt"]
    },
    "AvatarCatalogItem": {
      "title": "AvatarCatalogItem",
      "description": "Metadata danh mục avatar dùng chung lưu trên Firebase Storage (M7.3.5), chỉ Admin quản lý.",
      "type": "object",
      "properties": {
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "storagePath": { "type": "string", "minLength": 20, "maxLength": 260, "pattern": "^avatar_catalog/[A-Za-z0-9_-]+/v[1-9][0-9]*/[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp)$" },
        "contentType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
        "fileSize": { "type": "number" },
        "version": { "type": "number" },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [
        "avatarId",
        "name",
        "storagePath",
        "contentType",
        "fileSize",
        "version",
        "sortOrder",
        "isActive",
        "createdAt",
        "updatedAt",
        "updatedBy"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Hồ sơ vai trò quản trị / điều hành viên trong mô hình 3 vai trò (ADMIN duy nhất cho linhnk2013@gmail.com và MOD).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MOD"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "role", "isActive"]
    },
    "CoopRoomLobby": {
      "title": "CoopRoomLobby",
      "description": "Metadata tối thiểu của phòng chơi Co-op Online (không chứa WebRTC SDP/ICE, ảnh đại diện hay kết quả riêng).",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "status": { "type": "string", "enum": ["WAITING", "PLAYING", "FINISHED", "ABANDONED", "EXPIRED"] },
        "difficulty": { "type": "string", "enum": ["DEFAULT", "EXTREME"] },
        "hostUid": { "type": "string" },
        "hostDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "hostReady": { "type": "boolean" },
        "hostLastActiveAt": { "type": "number" },
        "guestUid": { "type": "string" },
        "guestDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "guestReady": { "type": "boolean" },
        "guestLastActiveAt": { "type": "number" },
        "rtcConnectionState": { "type": "string", "enum": ["NEW", "CONNECTING", "CONNECTED", "DISCONNECTED", "FAILED"] },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "disconnectReason": { "type": "string", "maxLength": 240 }
      },
      "required": [
        "roomCode",
        "status",
        "difficulty",
        "hostUid",
        "hostDisplayName",
        "hostReady",
        "hostLastActiveAt",
        "guestReady",
        "rtcConnectionState",
        "createdAt",
        "expiresAt"
      ]
    },
    "CoopRoomPrivateSignaling": {
      "title": "CoopRoomPrivateSignaling",
      "description": "Tài liệu phụ riêng tư chỉ cho phép Host và Guest đã tham gia phòng đọc/ghi WebRTC SDP/ICE và kết quả trận đấu.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "hostUid": { "type": "string" },
        "guestUid": { "type": "string" },
        "rtcOffer": { "type": "string", "maxLength": 16384 },
        "rtcAnswer": { "type": "string", "maxLength": 16384 },
        "hostIceCandidates": { "type": "string", "maxLength": 16384 },
        "guestIceCandidates": { "type": "string", "maxLength": 16384 },
        "finalScore": { "type": "number" },
        "matchOutcome": { "type": "string", "enum": ["VICTORY", "GAME_OVER"] },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "roomCode",
        "hostUid",
        "finalScore",
        "updatedAt"
      ]
    },
    "SystemAudioConfig": {
      "title": "SystemAudioConfig",
      "description": "Cấu hình nhạc nền chung toàn hệ thống (/system_config/audio) hỗ trợ Firebase Storage (sound_catalog/...) và đường dẫn tĩnh (audio/...).",
      "type": "object",
      "properties": {
        "assetPath": { "type": "string", "minLength": 6, "maxLength": 300 },
        "storagePath": { "type": "string", "maxLength": 300 },
        "soundId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "audioDataUrl": { "type": "string", "maxLength": 900000 },
        "fileName": { "type": "string", "minLength": 5, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+\\.(mp3|ogg|wav|m4a|aac|webm)$" },
        "contentType": { "type": "string", "minLength": 9, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "displayName": { "type": "string", "maxLength": 120 },
        "durationSec": { "type": "number" },
        "trimStartSec": { "type": "number" },
        "trimEndSec": { "type": "number" },
        "loopGapMs": { "type": "number" },
        "fadeOutMs": { "type": "number" }
      },
      "required": [
        "assetPath",
        "fileName",
        "contentType",
        "fileSize",
        "updatedAt",
        "updatedBy",
        "version",
        "isEnabled"
      ]
    },
    "SoundCatalogItem": {
      "title": "SoundCatalogItem",
      "description": "Metadata danh mục âm thanh dùng chung lưu trên Firebase Storage (/sound_catalog/{soundId}), chỉ Admin có quyền ghi.",
      "type": "object",
      "properties": {
        "soundId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fileName": { "type": "string", "minLength": 5, "maxLength": 180, "pattern": "^[A-Za-z0-9._-]+\\.(mp3|ogg|wav|m4a|aac|webm)$" },
        "storagePath": { "type": "string", "maxLength": 300 },
        "audioDataUrl": { "type": "string", "maxLength": 900000 },
        "contentType": { "type": "string", "minLength": 9, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "category": { "type": "string", "enum": ["BGM", "SFX"] },
        "actionSlot": { "type": "string", "enum": ["PLAYER_SHOOT", "TANK_EXPLODE", "BULLET_HIT_BRICK", "BULLET_HIT_STEEL", "BASE_DESTROYED"] },
        "durationSec": { "type": "number" },
        "trimStartSec": { "type": "number" },
        "trimEndSec": { "type": "number" },
        "version": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": [
        "soundId",
        "fileName",
        "storagePath",
        "contentType",
        "fileSize",
        "version",
        "isActive",
        "updatedAt",
        "updatedBy"
      ]
    },
    "SystemActionSfxConfig": {
      "title": "SystemActionSfxConfig",
      "description": "Cấu hình âm thanh hành động tùy chỉnh (/system_config/action_sfx) đồng bộ thời gian thực cho toàn bộ người chơi.",
      "type": "object",
      "properties": {
        "tracks": { "type": "object" },
        "slots": { "type": "object" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["updatedAt", "updatedBy", "version"]
    },
    "SystemMediaConfig": {
      "title": "SystemMediaConfig",
      "description": "Cấu hình Media toàn hệ thống (/system_config/media): chọn nhạc nền Trang chủ, Toàn game, chế độ (SOLO, COOP_AI, TWO_PLAYER), từng Stage, cấu hình vòng lặp liên tục và video nền Trang chủ (.mp4).",
      "type": "object",
      "properties": {
        "homeSoundId": { "type": ["string", "null"] },
        "globalSoundId": { "type": ["string", "null"] },
        "modeSoundIds": {
          "type": "object",
          "properties": {
            "SOLO": { "type": ["string", "null"] },
            "COOP_AI": { "type": ["string", "null"] },
            "TWO_PLAYER": { "type": ["string", "null"] }
          },
          "required": ["SOLO", "COOP_AI", "TWO_PLAYER"]
        },
        "stageSoundIds": { "type": "object" },
        "loopConfig": {
          "type": "object",
          "properties": {
            "loop": { "type": "boolean" },
            "skipSilence": { "type": "boolean" },
            "seamlessLoop": { "type": "boolean" },
            "crossfade": { "type": "boolean" },
            "crossfadeDurationSec": { "type": "number" },
            "silenceThresholdDb": { "type": "number" }
          },
          "required": ["loop", "skipSilence", "seamlessLoop", "crossfade", "crossfadeDurationSec", "silenceThresholdDb"]
        },
        "homeVideo": {
          "type": ["object", "null"],
          "properties": {
            "videoId": { "type": "string" },
            "displayName": { "type": "string" },
            "fileName": { "type": "string" },
            "storagePath": { "type": "string" },
            "contentType": { "type": "string", "enum": ["video/mp4"] },
            "fileSize": { "type": "number" },
            "version": { "type": "number" },
            "opacity": { "type": "number" },
            "loop": { "type": "boolean" },
            "isEnabled": { "type": "boolean" }
          }
        },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["homeSoundId", "globalSoundId", "modeSoundIds", "stageSoundIds", "loopConfig", "homeVideo", "updatedAt", "updatedBy", "version"]
    },
    "SystemStagesCatalogConfig": {
      "title": "SystemStagesCatalogConfig",
      "description": "Cấu hình danh sách màn chơi & bản đồ 13x13 (/system_config/stages_catalog) đồng bộ thời gian thực từ Admin tới toàn bộ người chơi.",
      "type": "object",
      "properties": {
        "stage1Map": { "type": "object" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "number" },
              "orderIndex": { "type": "number" },
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "INACTIVE"] },
              "version": { "type": "number" },
              "activeVersion": { "type": ["number", "null"] },
              "updatedAtMs": { "type": "number" },
              "updatedBy": { "type": "string" },
              "draftMapRows": { "type": "object" },
              "activeMapRows": { "type": ["object", "null"] },
              "enemyQueue": { "type": "array" },
              "spawnIntervalS": { "type": "number" }
            }
          }
        },
        "updatedAtMs": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["stage1Map", "stages", "updatedAtMs", "updatedBy", "version"]
    },
    "SystemDifficultyConfig": {
      "title": "SystemDifficultyConfig",
      "description": "Cấu hình chi tiết độ khó Giải trí (DEFAULT) và Thử thách (EXTREME) tại /system_config/difficulty.",
      "type": "object",
      "properties": {
        "activeDefaultDifficulty": { "type": "string", "enum": ["DEFAULT", "EXTREME"] },
        "profiles": { "type": "object" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["activeDefaultDifficulty", "profiles", "updatedAt", "updatedBy", "version"]
    },
    "SystemMaintenanceConfig": {
      "title": "SystemMaintenanceConfig",
      "description": "Cấu hình chế độ Bảo trì hệ thống tại /system_config/maintenance.",
      "type": "object",
      "properties": {
        "isActive": { "type": "boolean" },
        "startAtMs": { "type": "number" },
        "endAtMs": { "type": "number" },
        "message": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["isActive", "startAtMs", "endAtMs", "message", "updatedAt", "updatedBy", "version"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Tin nhắn góp ý / báo lỗi từ người chơi gửi tới Quản trị viên tại /contact_messages/{messageId}.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderEmail": { "type": "string", "minLength": 6, "maxLength": 254 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tag": { "type": "string", "enum": ["FEEDBACK", "BUG_REPORT"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "isSeen": { "type": "boolean" },
        "isHighlighted": { "type": "boolean" },
        "seenAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "messageId",
        "senderUid",
        "senderEmail",
        "senderName",
        "tag",
        "title",
        "content",
        "isSeen",
        "isHighlighted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Trạng thái trực tuyến M7.8 gắn với SessionManager (heartbeat 30s, timeout stale 90s, không chứa email).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "handleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "roleBadge": { "type": "string", "enum": ["ADMIN", "MOD", "PLAYER"] },
        "rankTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "stars": { "type": "number" },
        "online": { "type": "boolean" },
        "lastHeartbeatMs": { "type": "number" },
        "sessionId": { "type": ["string", "null"], "maxLength": 128 },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "uid",
        "handleTag",
        "displayName",
        "avatarUrl",
        "roleBadge",
        "rankTitle",
        "stars",
        "online",
        "lastHeartbeatMs",
        "sessionId",
        "updatedAtMs"
      ]
    },
    "PublicPlayerProfile": {
      "title": "PublicPlayerProfile",
      "description": "Hồ sơ công khai phục vụ tìm kiếm tài khoản Online + Offline (không chứa email/PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "handleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "displayNameLower": { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "roleBadge": { "type": "string", "enum": ["ADMIN", "MOD", "PLAYER"] },
        "rankTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "stars": { "type": "number" },
        "online": { "type": "boolean" },
        "lastHeartbeatMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "uid",
        "handleTag",
        "displayName",
        "displayNameLower",
        "avatarUrl",
        "roleBadge",
        "rankTitle",
        "stars",
        "online",
        "lastHeartbeatMs",
        "updatedAtMs"
      ]
    },
    "GlobalChatMessage": {
      "title": "GlobalChatMessage",
      "description": "Tin nhắn Chat chung toàn hệ thống (tối đa 300 ký tự, có clientMsgId chống trùng lặp).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientMsgId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "senderDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "senderAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "senderRoleBadge": { "type": "string", "enum": ["ADMIN", "MOD", "PLAYER"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAtMs": { "type": "number" },
        "status": { "type": "string", "enum": ["SENT", "MODERATED"] }
      },
      "required": [
        "id",
        "clientMsgId",
        "senderUid",
        "senderHandleTag",
        "senderDisplayName",
        "senderAvatarUrl",
        "senderRoleBadge",
        "content",
        "createdAtMs",
        "status"
      ]
    },
    "PrivateChatMessage": {
      "title": "PrivateChatMessage",
      "description": "Tin nhắn riêng 1-1 giữa hai người chơi (tôn trọng Block, không bao giờ xóa lịch sử).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 4, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+__[a-zA-Z0-9_\\-]+$" },
        "clientMsgId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "senderAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAtMs": { "type": "number" }
      },
      "required": [
        "id",
        "chatId",
        "clientMsgId",
        "senderUid",
        "senderDisplayName",
        "senderAvatarUrl",
        "recipientUid",
        "content",
        "createdAtMs"
      ]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Lời mời kết bạn giữa hai người chơi (reqId = fromUid__toUid).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 260 },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "fromHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "fromAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "toHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "toAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED", "CANCELLED"] },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "id",
        "fromUid",
        "fromDisplayName",
        "fromHandleTag",
        "fromAvatarUrl",
        "toUid",
        "toDisplayName",
        "toHandleTag",
        "toAvatarUrl",
        "status",
        "createdAtMs",
        "updatedAtMs"
      ]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Quan hệ bạn bè chuẩn hóa duy nhất 1 bản ghi cho mỗi cặp (pairId = userA__userB với userA < userB).",
      "type": "object",
      "properties": {
        "pairId": { "type": "string", "minLength": 4, "maxLength": 260 },
        "userA": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userB": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userADisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "userBDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "userAHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "userBHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "userAAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "userBAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "createdAtMs": { "type": "number" }
      },
      "required": [
        "pairId",
        "userA",
        "userB",
        "userADisplayName",
        "userBDisplayName",
        "userAHandleTag",
        "userBHandleTag",
        "userAAvatarUrl",
        "userBAvatarUrl",
        "createdAtMs"
      ]
    },
    "DeletedFriend": {
      "title": "DeletedFriend",
      "description": "Lịch sử danh sách đã xóa bạn riêng tư của từng tài khoản (/users/{uid}/deleted_friends/{targetUid}).",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetHandleTag": { "type": "string", "minLength": 3, "maxLength": 20 },
        "targetAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "deletedAtMs": { "type": "number" }
      },
      "required": [
        "targetUid",
        "targetDisplayName",
        "targetHandleTag",
        "targetAvatarUrl",
        "deletedAtMs"
      ]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Bản ghi chặn 1 chiều (/user_blocks/{blockerUid__blockedUid}), độc lập hoàn toàn với Unfriend.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 260 },
        "blockerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "blockedUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAtMs": { "type": "number" }
      },
      "required": ["id", "blockerUid", "blockedUid", "createdAtMs"]
    },
    "RoomInvite": {
      "title": "RoomInvite",
      "description": "Lời mời bạn bè vào phòng CO-OP ONLINE hoặc VS ONLINE (/room_invites/{inviteId}).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "roomMode": { "type": "string", "enum": ["COOP_ONLINE", "VS_P1_P2", "VS_P1_AI_P2_AI"] },
        "hasPassword": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "expiresAtMs": { "type": "number" }
      },
      "required": [
        "id",
        "fromUid",
        "fromDisplayName",
        "toUid",
        "roomCode",
        "roomMode",
        "hasPassword",
        "createdAtMs",
        "expiresAtMs"
      ]
    },
    "DisplayNameRegistry": {
      "title": "DisplayNameRegistry",
      "description": "Bảng đăng ký tên hiển thị duy nhất toàn hệ thống (/display_names/{nameHash}), không chứa email/PII.",
      "type": "object",
      "properties": {
        "nameHash": {
          "type": "string",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^dn_[a-f0-9]{64}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "displayNameNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "nameHash",
        "displayName",
        "displayNameNormalized",
        "ownerUid",
        "updatedAt"
      ]
    },
    "PrivateChatThread": {
      "title": "PrivateChatThread",
      "description": "Chỉ mục hội thoại nhắn tin riêng 1-1 (/private_chats/{chatId}) để liệt kê chính xác các tài khoản có lịch sử nhắn tin.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+__[a-zA-Z0-9_\\-]+$"
        },
        "userA": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userB": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userADisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "userBDisplayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "userAAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "userBAvatarUrl": { "type": ["string", "null"], "maxLength": 1024 },
        "lastSenderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lastMessageAtMs": { "type": "number" }
      },
      "required": [
        "chatId",
        "userA",
        "userB",
        "userADisplayName",
        "userBDisplayName",
        "userAAvatarUrl",
        "userBAvatarUrl",
        "lastSenderUid",
        "lastMessageAtMs"
      ]
    }
  },
  "firestore": {
    "/user_sessions/{uid}": {
      "schema": { "$ref": "#/entities/UserSession" },
      "description": "Lưu trữ khóa phiên đơn thiết bị theo UID."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Metadata lựa chọn avatar và tên hiển thị người chơi (M7.3.5)."
    },
    "/users/{uid}/deleted_friends/{targetUid}": {
      "schema": { "$ref": "#/entities/DeletedFriend" },
      "description": "Danh sách đã xóa bạn riêng tư của từng tài khoản (M7.8)."
    },
    "/display_names/{nameHash}": {
      "schema": { "$ref": "#/entities/DisplayNameRegistry" },
      "description": "Khóa duy nhất tên hiển thị toàn hệ thống (chống trùng lặp tên, không PII)."
    },
    "/avatar_catalog/{avatarId}": {
      "schema": { "$ref": "#/entities/AvatarCatalogItem" },
      "description": "Danh mục avatar dùng chung lưu trên Firebase Storage (M7.3.5)."
    },
    "/sound_catalog/{soundId}": {
      "schema": { "$ref": "#/entities/SoundCatalogItem" },
      "description": "Danh mục âm thanh & nhạc nền dùng chung lưu trên Firebase Storage."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
