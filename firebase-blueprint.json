{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "Khóa phiên đơn thiết bị (Single-Device Session Lock) chuẩn M7.1 với heartbeat 150s (tối thiểu 120s) và timeout 900s.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID của người chơi (bất biến, khớp ID tài liệu)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Mã phiên UUID v4 sinh ngẫu nhiên mới cho mỗi lần đăng nhập hợp lệ",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Mã định danh trình duyệt UUID v4 lưu trong localStorage/IndexedDB",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Trạng thái phiên đang hoạt động (true) hoặc đã đăng xuất (false)"
        },
        "userAgentSummary": {
          "type": "string",
          "description": "Mô tả ngắn gọn trình duyệt/hệ điều hành tối đa 120 ký tự",
          "minLength": 1,
          "maxLength": 120
        },
        "loginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm bắt đầu phiên theo request.time"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm heartbeat gần nhất theo request.time"
        }
      },
      "required": [
        "uid",
        "sessionId",
        "deviceId",
        "isActive",
        "userAgentSummary",
        "loginAt",
        "lastActiveAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Hồ sơ người chơi BanTank Online (khóa ghi trong M7.1).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "totalXp": { "type": "number" },
        "xuBalance": { "type": "number" },
        "rankLevel": { "type": "number" }
      },
      "required": ["uid", "totalXp", "xuBalance", "rankLevel"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Danh sách Super Admin (chỉ dành cho linhnk.online@gmail.com).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN"] }
      },
      "required": ["uid", "role"]
    },
    "CoopRoom": {
      "title": "CoopRoom",
      "description": "Phòng chơi Co-op Online 2 người chơi thật (Host P1 và Guest P2) sử dụng Firestore cho Signaling & WebRTC DataChannel cho đồng bộ trong trận.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 6, "maxLength": 6 },
        "status": { "type": "string", "enum": ["WAITING", "PLAYING", "FINISHED", "ABANDONED", "EXPIRED"] },
        "difficulty": { "type": "string", "enum": ["DEFAULT", "EXTREME"] },
        "hostUid": { "type": "string" },
        "hostDisplayName": { "type": "string" },
        "hostPhotoURL": { "type": "string" },
        "hostReady": { "type": "boolean" },
        "hostLastActiveAt": { "type": "number" },
        "guestUid": { "type": "string" },
        "guestDisplayName": { "type": "string" },
        "guestPhotoURL": { "type": "string" },
        "guestReady": { "type": "boolean" },
        "guestLastActiveAt": { "type": "number" },
        "rtcOffer": { "type": "string" },
        "rtcAnswer": { "type": "string" },
        "hostIceCandidates": { "type": "string" },
        "guestIceCandidates": { "type": "string" },
        "rtcConnectionState": { "type": "string", "enum": ["NEW", "CONNECTING", "CONNECTED", "DISCONNECTED", "FAILED"] },
        "finalScore": { "type": "number" },
        "matchOutcome": { "type": "string", "enum": ["VICTORY", "GAME_OVER"] },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "disconnectReason": { "type": "string" }
      },
      "required": [
        "roomCode",
        "status",
        "difficulty",
        "hostUid",
        "hostDisplayName",
        "hostPhotoURL",
        "hostReady",
        "hostLastActiveAt",
        "guestReady",
        "rtcConnectionState",
        "finalScore",
        "createdAt",
        "expiresAt"
      ]
    }
  },
  "firestore": {
    "/user_sessions/{uid}": {
      "schema": { "$ref": "#/entities/UserSession" },
      "description": "Lưu trữ khóa phiên đơn thiết bị theo UID."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Hồ sơ người chơi (khóa ghi trong M7.1)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Bảng quyền Super Admin chỉ dành cho linhnk.online@gmail.com."
    },
    "/coop_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/CoopRoom" },
      "description": "Phòng chơi Co-op Online tối đa 2 người chơi (Host P1 & Guest P2) dùng cho Signaling WebRTC."
    }
  }
}
