{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "Khóa phiên đơn thiết bị (Single-Device Session Lock) chuẩn M7.1 với heartbeat 150s (tối thiểu 120s) và timeout 900s.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID của người chơi (ghi khi tạo mới tx.set, tùy chọn khi tx.update)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Mã phiên UUID v4 sinh ngẫu nhiên mới cho mỗi lần đăng nhập hợp lệ",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "description": "Mã định danh trình duyệt UUID v4 lưu trong localStorage",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Trạng thái phiên đang hoạt động (true) hoặc đã đăng xuất (false)"
        },
        "userAgentSummary": {
          "type": "string",
          "description": "Mô tả ngắn gọn trình duyệt/hệ điều hành tối đa 120 ký tự",
          "minLength": 1,
          "maxLength": 120
        },
        "loginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm bắt đầu phiên theo request.time"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm heartbeat gần nhất theo request.time"
        }
      },
      "required": [
        "sessionId",
        "deviceId",
        "isActive",
        "userAgentSummary",
        "loginAt",
        "lastActiveAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Metadata hồ sơ và lựa chọn ảnh đại diện của người chơi (M7.3.5: Ảnh Google hoặc Danh mục Avatar chung). Không lưu nội dung ảnh hay quyền hạn.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "avatarType": { "type": "string", "enum": ["google", "catalog"] },
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "avatarUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["avatarType", "avatarId", "avatarUpdatedAt"]
    },
    "AvatarCatalogItem": {
      "title": "AvatarCatalogItem",
      "description": "Metadata danh mục avatar dùng chung lưu trên Firebase Storage (M7.3.5), chỉ Admin duy nhất linhnk2013@gmail.com quản lý.",
      "type": "object",
      "properties": {
        "avatarId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "storagePath": { "type": "string", "minLength": 20, "maxLength": 260, "pattern": "^avatar_catalog/[A-Za-z0-9_-]+/v[1-9][0-9]*/[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp)$" },
        "contentType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
        "fileSize": { "type": "number" },
        "version": { "type": "number" },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": [
        "avatarId",
        "name",
        "storagePath",
        "contentType",
        "fileSize",
        "version",
        "sortOrder",
        "isActive",
        "createdAt",
        "updatedAt",
        "updatedBy"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Hồ sơ vai trò quản trị / điều hành viên trong mô hình 3 vai trò (ADMIN duy nhất cho linhnk2013@gmail.com và MOD).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MOD"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "role", "isActive"]
    },
    "CoopRoomLobby": {
      "title": "CoopRoomLobby",
      "description": "Metadata tối thiểu của phòng chơi Co-op Online (không chứa WebRTC SDP/ICE, ảnh đại diện hay kết quả riêng).",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^BT[A-Z0-9]{4}$" },
        "status": { "type": "string", "enum": ["WAITING", "PLAYING", "FINISHED", "ABANDONED", "EXPIRED"] },
        "difficulty": { "type": "string", "enum": ["DEFAULT", "EXTREME"] },
        "hostUid": { "type": "string" },
        "hostDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "hostReady": { "type": "boolean" },
        "hostLastActiveAt": { "type": "number" },
        "guestUid": { "type": "string" },
        "guestDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "guestReady": { "type": "boolean" },
        "guestLastActiveAt": { "type": "number" },
        "rtcConnectionState": { "type": "string", "enum": ["NEW", "CONNECTING", "CONNECTED", "DISCONNECTED", "FAILED"] },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "disconnectReason": { "type": "string", "maxLength": 240 }
      },
      "required": [
        "roomCode",
        "status",
        "difficulty",
        "hostUid",
        "hostDisplayName",
        "hostReady",
        "hostLastActiveAt",
        "guestReady",
        "rtcConnectionState",
        "createdAt",
        "expiresAt"
      ]
    },
    "CoopRoomPrivateSignaling": {
      "title": "CoopRoomPrivateSignaling",
      "description": "Tài liệu phụ riêng tư chỉ cho phép Host và Guest đã tham gia phòng đọc/ghi WebRTC SDP/ICE và kết quả trận đấu.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^BT[A-Z0-9]{4}$" },
        "hostUid": { "type": "string" },
        "guestUid": { "type": "string" },
        "rtcOffer": { "type": "string", "maxLength": 16384 },
        "rtcAnswer": { "type": "string", "maxLength": 16384 },
        "hostIceCandidates": { "type": "string", "maxLength": 16384 },
        "guestIceCandidates": { "type": "string", "maxLength": 16384 },
        "finalScore": { "type": "number" },
        "matchOutcome": { "type": "string", "enum": ["VICTORY", "GAME_OVER"] },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "roomCode",
        "hostUid",
        "finalScore",
        "updatedAt"
      ]
    },
    "SystemAudioConfig": {
      "title": "SystemAudioConfig",
      "description": "Cấu hình nhạc nền chung toàn hệ thống (/system_config/audio) hỗ trợ Firebase Storage (sound_catalog/...) và đường dẫn tĩnh (audio/...).",
      "type": "object",
      "properties": {
        "assetPath": { "type": "string", "minLength": 6, "maxLength": 300 },
        "storagePath": { "type": "string", "maxLength": 300 },
        "soundId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "audioDataUrl": { "type": "string", "maxLength": 900000 },
        "fileName": { "type": "string", "minLength": 5, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+\\.(mp3|ogg|wav|m4a|aac|webm)$" },
        "contentType": { "type": "string", "minLength": 9, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "displayName": { "type": "string", "maxLength": 120 },
        "durationSec": { "type": "number" },
        "trimStartSec": { "type": "number" },
        "trimEndSec": { "type": "number" },
        "loopGapMs": { "type": "number" },
        "fadeOutMs": { "type": "number" }
      },
      "required": [
        "assetPath",
        "fileName",
        "contentType",
        "fileSize",
        "updatedAt",
        "updatedBy",
        "version",
        "isEnabled"
      ]
    },
    "SoundCatalogItem": {
      "title": "SoundCatalogItem",
      "description": "Metadata danh mục âm thanh dùng chung lưu trên Firebase Storage (/sound_catalog/{soundId}), chỉ Admin duy nhất linhnk2013@gmail.com ghi.",
      "type": "object",
      "properties": {
        "soundId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fileName": { "type": "string", "minLength": 5, "maxLength": 180, "pattern": "^[A-Za-z0-9._-]+\\.(mp3|ogg|wav|m4a|aac|webm)$" },
        "storagePath": { "type": "string", "maxLength": 300 },
        "audioDataUrl": { "type": "string", "maxLength": 900000 },
        "contentType": { "type": "string", "minLength": 9, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "category": { "type": "string", "enum": ["BGM", "SFX"] },
        "actionSlot": { "type": "string", "enum": ["PLAYER_SHOOT", "TANK_EXPLODE", "BULLET_HIT_BRICK", "BULLET_HIT_STEEL", "BASE_DESTROYED"] },
        "durationSec": { "type": "number" },
        "trimStartSec": { "type": "number" },
        "trimEndSec": { "type": "number" },
        "version": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": [
        "soundId",
        "fileName",
        "storagePath",
        "contentType",
        "fileSize",
        "version",
        "isActive",
        "updatedAt",
        "updatedBy"
      ]
    },
    "SystemActionSfxConfig": {
      "title": "SystemActionSfxConfig",
      "description": "Cấu hình âm thanh hành động tùy chỉnh (/system_config/action_sfx) đồng bộ thời gian thực cho toàn bộ người chơi.",
      "type": "object",
      "properties": {
        "tracks": { "type": "object" },
        "slots": { "type": "object" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["updatedAt", "updatedBy", "version"]
    },
    "SystemMediaConfig": {
      "title": "SystemMediaConfig",
      "description": "Cấu hình Media toàn hệ thống (/system_config/media): chọn nhạc nền Trang chủ, Toàn game, chế độ (SOLO, COOP_AI, TWO_PLAYER), từng Stage, cấu hình vòng lặp liên tục và video nền Trang chủ (.mp4).",
      "type": "object",
      "properties": {
        "homeSoundId": { "type": ["string", "null"] },
        "globalSoundId": { "type": ["string", "null"] },
        "modeSoundIds": {
          "type": "object",
          "properties": {
            "SOLO": { "type": ["string", "null"] },
            "COOP_AI": { "type": ["string", "null"] },
            "TWO_PLAYER": { "type": ["string", "null"] }
          },
          "required": ["SOLO", "COOP_AI", "TWO_PLAYER"]
        },
        "stageSoundIds": { "type": "object" },
        "loopConfig": {
          "type": "object",
          "properties": {
            "loop": { "type": "boolean" },
            "skipSilence": { "type": "boolean" },
            "seamlessLoop": { "type": "boolean" },
            "crossfade": { "type": "boolean" },
            "crossfadeDurationSec": { "type": "number" },
            "silenceThresholdDb": { "type": "number" }
          },
          "required": ["loop", "skipSilence", "seamlessLoop", "crossfade", "crossfadeDurationSec", "silenceThresholdDb"]
        },
        "homeVideo": {
          "type": ["object", "null"],
          "properties": {
            "videoId": { "type": "string" },
            "displayName": { "type": "string" },
            "fileName": { "type": "string" },
            "storagePath": { "type": "string" },
            "contentType": { "type": "string", "enum": ["video/mp4"] },
            "fileSize": { "type": "number" },
            "version": { "type": "number" },
            "opacity": { "type": "number" },
            "loop": { "type": "boolean" },
            "isEnabled": { "type": "boolean" }
          }
        },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" },
        "version": { "type": "number" }
      },
      "required": ["homeSoundId", "globalSoundId", "modeSoundIds", "stageSoundIds", "loopConfig", "homeVideo", "updatedAt", "updatedBy", "version"]
    }
  },
  "firestore": {
    "/user_sessions/{uid}": {
      "schema": { "$ref": "#/entities/UserSession" },
      "description": "Lưu trữ khóa phiên đơn thiết bị theo UID."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Metadata lựa chọn avatar và tên hiển thị người chơi (M7.3.5)."
    },
    "/avatar_catalog/{avatarId}": {
      "schema": { "$ref": "#/entities/AvatarCatalogItem" },
      "description": "Danh mục avatar dùng chung lưu trên Firebase Storage (M7.3.5)."
    },
    "/sound_catalog/{soundId}": {
      "schema": { "$ref": "#/entities/SoundCatalogItem" },
      "description": "Danh mục âm thanh & nhạc nền dùng chung lưu trên Firebase Storage."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Bảng phân quyền ADMIN duy nhất (linhnk2013@gmail.com) và MOD."
    },
    "/coop_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/CoopRoomLobby" },
      "description": "Metadata phòng chờ Co-op Online tối thiểu."
    },
    "/coop_rooms/{roomCode}/private/{docId}": {
      "schema": { "$ref": "#/entities/CoopRoomPrivateSignaling" },
      "description": "Signaling WebRTC (SDP Offer/Answer, ICE) và kết quả trận đấu riêng tư cho Host & Guest."
    },
    "/system_config/{docId}": {
      "schema": { "$ref": "#/entities/SystemAudioConfig" },
      "description": "Cấu hình hệ thống (/system_config/audio, /system_config/media, /system_config/stages_catalog, /system_config/action_sfx)."
    }
  }
}

