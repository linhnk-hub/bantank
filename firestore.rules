rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. Primitive Helpers & Personal Gmail Verification
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTokenId(token) {
      return token is string
        && token.size() >= 16
        && token.size() <= 64
        && token.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Xác thực phía máy chủ:
    // - Phải đăng nhập qua Google ('google.com')
    // - Email đã xác minh (email_verified == true)
    // - Email kết thúc chính xác bằng @gmail.com hoặc @googlemail.com
    // - Không chứa claim 'hd' (Hosted Domain của Google Workspace)
    function isVerifiedPersonalGmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && request.auth.token.email.size() <= 254
        && request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@(gmail|googlemail)\\.com$')
        && !('hd' in request.auth.token);
    }

    function isOwner(uid) {
      return isVerifiedPersonalGmail() && request.auth.uid == uid;
    }

    // M7.3: Chỉ định Super Admin chính thức và duy nhất của hệ thống
    function isSuperAdmin() {
      return isVerifiedPersonalGmail()
        && request.auth.token.email == 'linhnk.online@gmail.com';
    }

    // Kiểm tra phiên hiện tại có còn hiệu lực trong vòng 900 giây (15 phút) theo giờ máy chủ hay không
    function isExistingSessionStillActive() {
      return existing().isActive == true
        && request.time <= existing().lastActiveAt + duration.value(900, 's');
    }

    // =========================================================================
    // 2. Validation Helper cho UserSession (Chuẩn M7.1 - Khớp 100% sessionManager.ts)
    // =========================================================================
    function isValidUserSession(data, uid) {
      return data.keys().hasAll([
          'uid',
          'sessionId',
          'deviceId',
          'isActive',
          'userAgentSummary',
          'loginAt',
          'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'sessionId',
          'deviceId',
          'isActive',
          'userAgentSummary',
          'loginAt',
          'lastActiveAt',
          'expiresAt'
        ])
        && data.uid == uid
        && data.uid == request.auth.uid
        && isValidTokenId(data.sessionId)
        && isValidTokenId(data.deviceId)
        && data.isActive is bool
        && data.userAgentSummary is string
        && data.userAgentSummary.size() >= 1
        && data.userAgentSummary.size() <= 120
        && data.loginAt is timestamp
        && data.lastActiveAt is timestamp
        && (!('expiresAt' in data) || data.expiresAt is timestamp || data.expiresAt is int);
    }

    // Hành động 1: Heartbeat từ cùng thiết bị & cùng phiên đang hoạt động
    // - Bắt buộc phiên còn hiệu lực (<= 900s) VÀ cách lần cập nhật trước tối thiểu 120s
    // - Chỉ được phép cập nhật trường 'lastActiveAt' bằng giờ máy chủ (request.time)
    function isSameDeviceHeartbeatAction() {
      return existing().isActive == true
        && isExistingSessionStillActive()
        && request.time >= existing().lastActiveAt + duration.value(120, 's')
        && incoming().deviceId == existing().deviceId
        && incoming().sessionId == existing().sessionId
        && incoming().loginAt == existing().loginAt
        && incoming().userAgentSummary == existing().userAgentSummary
        && incoming().isActive == true
        && incoming().lastActiveAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'expiresAt']);
    }

    // Hành động 2: Đăng xuất chủ động hoặc giải phóng phiên từ cùng thiết bị & cùng phiên đang hoạt động
    // - Bắt buộc phiên đang ở trạng thái isActive == true chuyển sang isActive == false
    function isSameDeviceLogoutAction() {
      return existing().isActive == true
        && incoming().deviceId == existing().deviceId
        && incoming().sessionId == existing().sessionId
        && incoming().loginAt == existing().loginAt
        && incoming().userAgentSummary == existing().userAgentSummary
        && incoming().isActive == false
        && incoming().lastActiveAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'lastActiveAt', 'expiresAt']);
    }

    // Hành động 3: Chiếm phiên đăng nhập mới hợp lệ (First-Active-Session Wins)
    // - Chỉ được phép khi:
    //   (a) Phiên cũ không còn hoạt động (!isExistingSessionStillActive(): đã isActive == false hoặc đã quá 900s), HOẶC
    //   (b) Cùng chính thiết bị đó (incoming().deviceId == existing().deviceId) đăng nhập/khởi tạo lại phiên mới
    function isNewSessionAcquisitionAction() {
      return (
          !isExistingSessionStillActive()
          || incoming().deviceId == existing().deviceId
        )
        && incoming().isActive == true
        && incoming().sessionId != existing().sessionId
        && incoming().loginAt == request.time
        && incoming().lastActiveAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sessionId',
          'deviceId',
          'isActive',
          'userAgentSummary',
          'loginAt',
          'lastActiveAt',
          'expiresAt'
        ]);
    }

    // =========================================================================
    // 3. Collection Rules: /user_sessions/{uid}
    // =========================================================================
    match /user_sessions/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUserSession(incoming(), uid)
        && incoming().isActive == true
        && incoming().loginAt == request.time
        && incoming().lastActiveAt == request.time;

      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidUserSession(incoming(), uid)
        && incoming().uid == existing().uid
        && (
          isSameDeviceHeartbeatAction()
          || isSameDeviceLogoutAction()
          || isNewSessionAcquisitionAction()
        );

      allow delete: if false;
    }

    // =========================================================================
    // 4. Collection Rules: /admins/{uid} (M7.3: Chỉ Super Admin linhnk.online@gmail.com)
    // =========================================================================
    match /admins/{uid} {
      allow get: if (isValidId(uid) && isOwner(uid)) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 5. Collection Rules: /users/{uid} (Khóa ghi tuyệt đối trong M7.1)
    // =========================================================================
    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 6. Validation & Role Helpers cho /coop_rooms/{roomCode} (M7.3 FIX)
    //    Firestore chỉ dùng cho tạo/vào phòng, Ready, WebRTC Signaling và kết quả cuối trận.
    // =========================================================================
    function isValidCoopRoomSchema(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'status',
          'difficulty',
          'hostUid',
          'hostDisplayName',
          'hostPhotoURL',
          'hostReady',
          'hostLastActiveAt',
          'guestUid',
          'guestDisplayName',
          'guestPhotoURL',
          'guestReady',
          'guestLastActiveAt',
          'rtcOffer',
          'rtcAnswer',
          'hostIceCandidates',
          'guestIceCandidates',
          'rtcConnectionState',
          'finalScore',
          'matchOutcome',
          'createdAt',
          'expiresAt',
          'disconnectReason'
        ])
        && data.keys().hasOnly([
          'roomCode',
          'status',
          'difficulty',
          'hostUid',
          'hostDisplayName',
          'hostPhotoURL',
          'hostReady',
          'hostLastActiveAt',
          'guestUid',
          'guestDisplayName',
          'guestPhotoURL',
          'guestReady',
          'guestLastActiveAt',
          'rtcOffer',
          'rtcAnswer',
          'hostIceCandidates',
          'guestIceCandidates',
          'rtcConnectionState',
          'finalScore',
          'matchOutcome',
          'createdAt',
          'expiresAt',
          'disconnectReason'
        ])
        && roomCode.matches('^[A-Z0-9]{6}$')
        && data.roomCode == roomCode
        && data.status in ['WAITING', 'PLAYING', 'FINISHED', 'ABANDONED', 'EXPIRED']
        && data.difficulty in ['DEFAULT', 'EXTREME']
        && isValidId(data.hostUid)
        && data.hostDisplayName is string
        && data.hostDisplayName.size() >= 1
        && data.hostDisplayName.size() <= 80
        && data.hostPhotoURL is string
        && data.hostPhotoURL.size() <= 512
        && data.hostReady is bool
        && data.hostLastActiveAt is int
        && data.hostLastActiveAt > 0
        && (data.guestUid == null || (isValidId(data.guestUid) && data.guestUid != data.hostUid))
        && (data.guestDisplayName == null || (data.guestDisplayName is string && data.guestDisplayName.size() >= 1 && data.guestDisplayName.size() <= 80))
        && (data.guestPhotoURL == null || (data.guestPhotoURL is string && data.guestPhotoURL.size() <= 512))
        && data.guestReady is bool
        && (data.guestLastActiveAt == null || (data.guestLastActiveAt is int && data.guestLastActiveAt > 0))
        && (data.rtcOffer == null || (data.rtcOffer is string && data.rtcOffer.size() <= 16384))
        && (data.rtcAnswer == null || (data.rtcAnswer is string && data.rtcAnswer.size() <= 16384))
        && (data.hostIceCandidates == null || (data.hostIceCandidates is string && data.hostIceCandidates.size() <= 16384))
        && (data.guestIceCandidates == null || (data.guestIceCandidates is string && data.guestIceCandidates.size() <= 16384))
        && data.rtcConnectionState in ['NEW', 'CONNECTING', 'CONNECTED', 'DISCONNECTED', 'FAILED']
        && data.finalScore is int
        && data.finalScore >= 0
        && data.finalScore <= 9999999
        && (data.matchOutcome == null || data.matchOutcome in ['VICTORY', 'GAME_OVER'])
        && data.createdAt is int
        && data.createdAt > 0
        && data.expiresAt is int
        && data.expiresAt > data.createdAt
        && data.expiresAt <= data.createdAt + 900000
        && (data.disconnectReason == null || (data.disconnectReason is string && data.disconnectReason.size() <= 240));
    }

    function isCoopRoomNotExpired() {
      return existing().status != 'EXPIRED'
        && request.time.toMillis() < existing().expiresAt;
    }

    function isImmutableCoopCoreUnchanged() {
      return incoming().roomCode == existing().roomCode
        && incoming().hostUid == existing().hostUid
        && incoming().hostDisplayName == existing().hostDisplayName
        && incoming().hostPhotoURL == existing().hostPhotoURL
        && incoming().difficulty == existing().difficulty
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt;
    }

    // Nhánh 1: Host (P1) cập nhật trạng thái điều phối phòng, Ready, WebRTC Offer/ICE hoặc kết quả cuối trận
    // - Không được tự ý ghi đè thông tin Guest hoặc đổi guestUid sang người thứ 3
    // - Chỉ được chuyển sang PLAYING khi đã có Guest và cả 2 đã Ready
    function isCoopHostUpdateAction() {
      return request.auth.uid == existing().hostUid
        && (isCoopRoomNotExpired() || incoming().status in ['ABANDONED', 'EXPIRED', 'FINISHED'])
        && incoming().guestUid == existing().guestUid
        && incoming().guestDisplayName == existing().guestDisplayName
        && incoming().guestPhotoURL == existing().guestPhotoURL
        && (
          incoming().status != 'PLAYING'
          || existing().status == 'PLAYING'
          || (
            existing().status == 'WAITING'
            && existing().guestUid != null
            && existing().hostReady == true
            && existing().guestReady == true
          )
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'hostReady',
          'hostLastActiveAt',
          'rtcOffer',
          'hostIceCandidates',
          'rtcConnectionState',
          'finalScore',
          'matchOutcome',
          'disconnectReason'
        ]);
    }

    // Nhánh 2: Guest (P2) tham gia vào phòng đang WAITING và chưa có Guest (chặn tuyệt đối người thứ 3)
    function isCoopGuestJoinAction() {
      return isCoopRoomNotExpired()
        && existing().status == 'WAITING'
        && existing().guestUid == null
        && request.auth.uid != existing().hostUid
        && incoming().guestUid == request.auth.uid
        && incoming().status == 'WAITING'
        && incoming().guestReady == false
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'guestUid',
          'guestDisplayName',
          'guestPhotoURL',
          'guestReady',
          'guestLastActiveAt',
          'rtcAnswer',
          'guestIceCandidates',
          'rtcConnectionState',
          'disconnectReason'
        ]);
    }

    // Nhánh 3: Guest (P2) đã ở trong phòng cập nhật trạng thái Ready hoặc WebRTC Answer/ICE
    // - Không được phép sửa status, hostUid, difficulty hoặc các trường của Host
    function isCoopGuestSignalingOrReadyAction() {
      return isCoopRoomNotExpired()
        && existing().status in ['WAITING', 'PLAYING']
        && existing().guestUid != null
        && request.auth.uid == existing().guestUid
        && incoming().guestUid == existing().guestUid
        && incoming().guestDisplayName == existing().guestDisplayName
        && incoming().guestPhotoURL == existing().guestPhotoURL
        && incoming().status == existing().status
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'guestReady',
          'guestLastActiveAt',
          'rtcAnswer',
          'guestIceCandidates',
          'rtcConnectionState'
        ]);
    }

    // Nhánh 4: Guest (P2) rời phòng hợp lệ
    // - Khi phòng đang WAITING: giải phóng slot Guest về null để người khác có thể vào
    // - Khi phòng đang PLAYING: chuyển trạng thái phòng sang ABANDONED và ghi lý do ngắt kết nối
    function isCoopGuestLeaveAction() {
      return existing().guestUid != null
        && request.auth.uid == existing().guestUid
        && (
          (
            existing().status == 'WAITING'
            && incoming().status == 'WAITING'
            && incoming().guestUid == null
            && incoming().guestDisplayName == null
            && incoming().guestPhotoURL == null
            && incoming().guestReady == false
            && incoming().guestLastActiveAt == null
            && incoming().rtcAnswer == null
            && incoming().guestIceCandidates == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'guestUid',
              'guestDisplayName',
              'guestPhotoURL',
              'guestReady',
              'guestLastActiveAt',
              'rtcAnswer',
              'guestIceCandidates',
              'rtcConnectionState',
              'disconnectReason'
            ])
          )
          || (
            existing().status == 'PLAYING'
            && incoming().status == 'ABANDONED'
            && incoming().guestUid == existing().guestUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'guestLastActiveAt',
              'rtcConnectionState',
              'disconnectReason'
            ])
          )
        );
    }

    // =========================================================================
    // 7. Collection Rules: /coop_rooms/{roomCode}
    // =========================================================================
    match /coop_rooms/{roomCode} {
      // Cho phép đọc trực tiếp theo mã phòng 6 ký tự (get); chặn liệt kê toàn bộ danh sách phòng (list)
      allow get: if isVerifiedPersonalGmail() && roomCode.matches('^[A-Z0-9]{6}$');
      allow list: if isSuperAdmin();

      // Tạo phòng: Người tạo bắt buộc là Chủ phòng (hostUid == request.auth.uid), trạng thái WAITING, guestUid == null
      allow create: if isVerifiedPersonalGmail()
        && isValidCoopRoomSchema(incoming(), roomCode)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'WAITING'
        && incoming().guestUid == null
        && incoming().guestDisplayName == null
        && incoming().guestPhotoURL == null
        && incoming().guestReady == false
        && incoming().guestLastActiveAt == null
        && incoming().rtcOffer == null
        && incoming().rtcAnswer == null
        && incoming().hostIceCandidates == null
        && incoming().guestIceCandidates == null
        && incoming().rtcConnectionState == 'NEW'
        && incoming().finalScore == 0
        && incoming().matchOutcome == null
        && incoming().disconnectReason == null
        && request.time.toMillis() < incoming().expiresAt;

      // Cập nhật phòng: Kiểm tra schema nghiêm ngặt, khóa các trường bất biến và phân tách quyền theo đúng vai trò
      allow update: if isVerifiedPersonalGmail()
        && isValidCoopRoomSchema(incoming(), roomCode)
        && isImmutableCoopCoreUnchanged()
        && (
          isCoopHostUpdateAction()
          || isCoopGuestJoinAction()
          || isCoopGuestSignalingOrReadyAction()
          || isCoopGuestLeaveAction()
        );

      allow delete: if isSuperAdmin();
    }
  }
}
